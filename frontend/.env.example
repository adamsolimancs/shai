# API
BACKEND_API_BASE_URL="http://localhost:8080"
BACKEND_API_KEY=dev-secret-key
# Optional override. Leave unset to select the current NBA season automatically.
NBA_DEFAULT_SEASON=""
BACKEND_API_TIMEOUT_MS=10000
# Vercel automatically supplies the trusted visitor IP. For another deployment,
# set this ONLY behind an ingress that overwrites this header and protects origin access.
# TRUSTED_CLIENT_IP_HEADER=x-your-ingress-client-ip

NODE_ENV="development"

# Auth
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
