# backend env
BACKEND_ENV="development"
PORT=8080
API_KEY=dev-secret-key
# Production requires BACKEND_ENV=production, an explicit random API_KEY of at
# least 32 characters, and DATABASE_URL. Match the frontend BACKEND_API_KEY.

# cache
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Neon Postgres (pooled application connection)
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=verify-full"
DATABASE_SCHEMA="public"

CACHE_DEFAULT_TTL_SECONDS=7200
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_SERVICE_REQUESTS_PER_MINUTE=6000
READINESS_TIMEOUT_SECONDS=2
CACHE_REDIS_TIMEOUT_SECONDS=0.5
CORS_ALLOW_ORIGINS=*
